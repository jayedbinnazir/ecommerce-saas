# ============================================================
# PLATFORM
# ============================================================

APP_ENV=dev

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PORT=6379

KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094

# Shared object storage (MinIO in dev, S3 in prod)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# ============================================================
# USER MANAGEMENT
# ============================================================

USER_DB_HOST=postgres
USER_DB_PORT=5432
USER_DB_NAME=user_management_db

USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=8080
USER_SERVICE_MODE=debug

USER_JWT_SECRET=change-this-in-development
USER_JWT_EXPIRES=24h
USER_JWT_ACCESS_TTL=15m
USER_JWT_REFRESH_TTL=7d

USER_REDIS_HOST=redis
USER_REDIS_PORT=6379

USER_KAFKA_BROKERS=kafka:9092

# store creation checks an active subscription in payment-service
USER_PAYMENT_SERVICE_URL=http://payment-service:8080
USER_PAYMENT_INTERNAL_KEY=dev-internal-key

# forgot-password email
# MUST match MAIL_INTERNAL_KEY
USER_MAIL_SERVICE_URL=http://mail-service:8080
USER_MAIL_INTERNAL_KEY=dev-internal-key

# key other services use to call user-management's /api/v1/internal (mail-service)
USER_INTERNAL_KEY=dev-internal-key

# ---- Auth cookies + OAuth redirect target ----
# where the OAuth callback sends the browser after a successful login
USER_AUTH_FRONTEND_URL=http://localhost:3000
USER_AUTH_COOKIE_DOMAIN=
USER_AUTH_COOKIE_SECURE=false

# ---- Google OAuth ----
# Console: APIs & Services > Credentials > OAuth 2.0 Client ID
#   Authorized redirect URI must equal USER_AUTH_GOOGLE_REDIRECT_URL exactly.
# Leave CLIENT_ID/SECRET blank to disable Google login (email+password still works).
USER_AUTH_GOOGLE_CLIENT_ID=553826042390-a6r5eosrl8rr0q4i9refph8qr36t4svh.apps.googleusercontent.com
USER_AUTH_GOOGLE_CLIENT_SECRET=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
USER_AUTH_GOOGLE_REDIRECT_URL=http://localhost:8081/api/v1/auth/google/callback

# ---- Facebook OAuth ---- (optional, same idea)
USER_AUTH_FACEBOOK_CLIENT_ID=1585525883044386
USER_AUTH_FACEBOOK_CLIENT_SECRET=bd8f2d9fe3df8532fc181b40976a1f72
USER_AUTH_FACEBOOK_REDIRECT_URL=http://localhost:8081/api/v1/auth/facebook/callback


# ============================================================
# PRODUCT
# ============================================================

PRODUCT_DB_HOST=postgres
PRODUCT_DB_PORT=5432
PRODUCT_DB_NAME=product_db

PRODUCT_SERVICE_HOST=0.0.0.0
PRODUCT_SERVICE_PORT=8080
PRODUCT_SERVICE_MODE=debug

# MUST match USER_JWT_SECRET — product-service verifies user-management's tokens
PRODUCT_JWT_SECRET=change-this-in-development

PRODUCT_KAFKA_BROKERS=kafka:9092
PRODUCT_USER_SERVICE_URL=http://user-management:8080

PRODUCT_S3_BUCKET=product-images
PRODUCT_S3_REGION=us-east-1
PRODUCT_S3_ENDPOINT=http://minio:9000
PRODUCT_S3_PUBLIC_BASE_URL=http://localhost:9000/product-images
PRODUCT_S3_ACCESS_KEY_ID=minioadmin
PRODUCT_S3_SECRET_ACCESS_KEY=minioadmin


# ============================================================
# INVENTORY
# ============================================================

INVENTORY_DB_HOST=postgres
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory_db

INVENTORY_SERVICE_HOST=0.0.0.0
INVENTORY_SERVICE_PORT=8080
INVENTORY_SERVICE_MODE=debug

# MUST match USER_JWT_SECRET — inventory-service verifies user-management's tokens
INVENTORY_JWT_SECRET=change-this-in-development

INVENTORY_KAFKA_BROKERS=kafka:9092
INVENTORY_USER_SERVICE_URL=http://user-management:8080

# shared secret for the service-to-service bulk stock API (order-service calls it)
INVENTORY_INTERNAL_KEY=dev-internal-key


# ============================================================
# CART
# ============================================================

CART_DB_HOST=postgres
CART_DB_PORT=5432
CART_DB_NAME=cart_db

CART_SERVICE_HOST=0.0.0.0
CART_SERVICE_PORT=8080
CART_SERVICE_MODE=debug

# MUST match USER_JWT_SECRET — cart-service verifies user-management's tokens
CART_JWT_SECRET=change-this-in-development

CART_KAFKA_BROKERS=kafka:9092
CART_USER_SERVICE_URL=http://user-management:8080
CART_PRODUCT_SERVICE_URL=http://product-service:8080
CART_INVENTORY_SERVICE_URL=http://inventory-service:8080


# ============================================================
# ORDER
# ============================================================

ORDER_DB_HOST=postgres
ORDER_DB_PORT=5432
ORDER_DB_NAME=order_db

ORDER_SERVICE_HOST=0.0.0.0
ORDER_SERVICE_PORT=8080
ORDER_SERVICE_MODE=debug

# MUST match USER_JWT_SECRET — order-service verifies user-management's tokens
ORDER_JWT_SECRET=change-this-in-development

ORDER_KAFKA_BROKERS=kafka:9092
ORDER_USER_SERVICE_URL=http://user-management:8080
ORDER_CART_SERVICE_URL=http://cart-service:8080
ORDER_INVENTORY_SERVICE_URL=http://inventory-service:8080
# MUST match INVENTORY_INTERNAL_KEY
ORDER_INVENTORY_INTERNAL_KEY=dev-internal-key
ORDER_PAYMENT_SERVICE_URL=http://payment-service:8080
# MUST match PAYMENT_INTERNAL_KEY
ORDER_PAYMENT_INTERNAL_KEY=dev-internal-key
# order.* lifecycle events are published to the "order-events" Kafka topic


# ============================================================
# PAYMENT
# ============================================================

PAYMENT_DB_HOST=postgres
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=payment_db

PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=8080
PAYMENT_SERVICE_MODE=debug

# MUST match USER_JWT_SECRET — payment-service verifies user-management's tokens
PAYMENT_JWT_SECRET=change-this-in-development

PAYMENT_KAFKA_BROKERS=kafka:9092
PAYMENT_USER_SERVICE_URL=http://user-management:8080

# shared secret for order-service + user-management -> payment-service internal API
PAYMENT_INTERNAL_KEY=dev-internal-key

# ---- Stripe (card payments) ----
# Leave BOTH blank to run the gateway in stub mode (cards "succeed" instantly).
# For real card flows, put your Stripe TEST keys here:
#   PAYMENT_STRIPE_SECRET_KEY=sk_test_xxx
#   PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_STRIPE_SECRET_KEY=sk_test_51UE2gGBPQJ9jcRLHIbCqTtwQwU1r09EhxRSxeW3lAaB1kC90UpXaECqLGrlbh4V3BmvAFeHSFdQ1YLKdkuyh7wOu00UXXWMdEI
PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_479d34b4dca733edb764b2101b8f675659bf42809e2b73c8874d57e5253a65a3


# ============================================================
# MAIL
# ============================================================

MAIL_DB_HOST=postgres
MAIL_DB_PORT=5432
MAIL_DB_NAME=mail_db

MAIL_SERVICE_HOST=0.0.0.0
MAIL_SERVICE_PORT=8080
MAIL_SERVICE_MODE=debug

MAIL_KAFKA_BROKERS=kafka:9092

# shared secret for the mail-service internal HTTP API
MAIL_INTERNAL_KEY=dev-internal-key

# mail-service resolves recipient name+email from user-management on a Kafka event
MAIL_USER_SERVICE_URL=http://user-management:8080
# MUST match USER_INTERNAL_KEY
MAIL_USER_INTERNAL_KEY=dev-internal-key

# ---- SMTP relay ----
# Dev: delivers into the bundled Mailpit container — inbox UI at http://localhost:8025.
# Blank MAIL_SMTP_HOST = stub mode (mail logged, not delivered).
# Real email: swap in a provider's SMTP creds (Resend / Postmark / Brevo / SES / Gmail app password).
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM=Platform (dev) <no-reply@localhost>


# ============================================================
# NOTIFICATION
# ============================================================

NOTIFICATION_DB_HOST=postgres
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db

NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8080
NOTIFICATION_SERVICE_MODE=debug

# MUST match USER_JWT_SECRET — notification-service verifies user-management's tokens
NOTIFICATION_JWT_SECRET=change-this-in-development

NOTIFICATION_KAFKA_BROKERS=kafka:9092
NOTIFICATION_USER_SERVICE_URL=http://user-management:8080
NOTIFICATION_MAIL_SERVICE_URL=http://mail-service:8080
# MUST match MAIL_INTERNAL_KEY
NOTIFICATION_MAIL_INTERNAL_KEY=dev-internal-key

# shared secret for order-service (and others) -> notification-service internal API
NOTIFICATION_INTERNAL_KEY=dev-internal-key